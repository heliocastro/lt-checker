{
  "name": "lt-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension for grammar and spell checking with a self-hosted LanguageTool server",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "build": "vp build",
    "zip": "vp build && cd dist && zip -qr ../lt-checker.zip .",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
